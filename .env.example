# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Load into your shell before running the app:
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# Quote every value. DB_URL contains '&', which the shell treats as a control
# operator otherwise — `source .env` then fails and exports NOTHING, and the app
# dies on "Could not resolve placeholder 'JWT_SECRET'".

DB_URL="jdbc:mysql://localhost:3306/timetable_scheduler?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
DB_USERNAME="root"
DB_PASSWORD="change-me"

# HMAC-SHA key for signing JWTs. Must be at least 32 bytes for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-value-at-least-32-bytes"

# Token lifetime as a Spring duration, e.g. 3600s, 1h, 30m.
JWT_EXPIRATION="3600s"
